NODE_ENV=development
PORT=5000

# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb://127.0.0.1:27017/cupcraft

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:3000

# Storefront cache revalidation (must match REVALIDATE_SECRET in the frontend env)
STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-to-another-long-random-string

# Where uploaded product/header images are stored (relative to backend/ or absolute)
UPLOAD_DIR=uploads

# Store name and public storefront URL used in order emails
STORE_NAME=CupCraft Wholesale
STOREFRONT_URL=http://localhost:3000

# SMTP for order emails (Nodemailer). Leave SMTP_HOST empty in development to save emails as
# HTML previews in mail-previews/ instead of sending them. Port 465 needs SMTP_SECURE=true.
# Gmail/Google Workspace: smtp.gmail.com, 465, secure=true, an App Password as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CupCraft Wholesale <orders@example.com>"

# Used by `npm run seed:admin`
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_PHONE=+910000000000
