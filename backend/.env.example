NODE_ENV=development
PORT=5000

# MongoDB connection string (Atlas or self-hosted)
MONGODB_URI=mongodb://127.0.0.1:27017/cupcraft

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:3000

# Storefront cache revalidation (must match REVALIDATE_SECRET in the frontend env)
STOREFRONT_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me-to-another-long-random-string

# Where uploaded product/header images are stored (relative to backend/ or absolute)
UPLOAD_DIR=uploads

# SMTP (used by Nodemailer in Phase 4)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CupCraft Wholesale <orders@example.com>"

# Used by `npm run seed:admin`
ADMIN_NAME=Store Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_PHONE=+910000000000
